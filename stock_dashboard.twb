      <aliases enabled='yes' />
      <column caption='BB lower' datatype='real' name='[BB_lower]' role='measure' type='quantitative' />
      <column caption='BB upper' datatype='real' name='[BB_upper]' role='measure' type='quantitative' />
      <column caption='BB width' datatype='real' name='[BB_width]' role='measure' type='quantitative' />
      <column caption='Return Direction' datatype='string' name='[Calculation_0583320518340610]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF AVG([Calculation_0691347519967234]) &gt; 0 THEN &quot;Positive&quot; ELSE &quot;Negative&quot; END' />
      </column>
      <column caption='Top Gainer Ticker' datatype='string' name='[Calculation_0583320519053315]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{ FIXED : MAX(&#13;&#10;        IF [Calculation_0691347519967234] = { FIXED : MAX([Calculation_0691347519967234]) } &#13;&#10;        THEN [Ticker] END&#13;&#10;      ) }' />
      </column>
      <column caption='market_breadth' datatype='real' name='[Calculation_0583320519516164]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [Daily_Return]&gt;0 THEN [Ticker] END) / COUNTD([Ticker])' />
      </column>
      <column caption='Is Latest Date' datatype='boolean' name='[Calculation_0583320521936901]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Date] = {FIXED : MAX([Date])}' />
      </column>
      <column caption='Ticker Filter' datatype='boolean' name='[Calculation_0583320532459527]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Ticker] = [Parameters].[Parameter 0583320532123654]' />
      </column>
      <column caption='Latest Close' datatype='real' name='[Calculation_0691347519827969]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Date] = {FIXED : MAX([Date])}&#13;&#10;  THEN [Close] END' />
      </column>
      <column caption='YTD Return %' datatype='real' name='[Calculation_0691347519967234]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Cumulative_Return] * 100' />
      </column>
      <column caption='Is Overbought' datatype='boolean' name='[Calculation_0691347520114692]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[RSI_14] &gt;= 70' />
      </column>
      <column caption=' Is Oversold' datatype='boolean' name='[Calculation_0691347520180229]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[RSI_14] &lt;= 30' />
      </column>
      <column caption='Trend Signal' datatype='string' name='[Calculation_0691347520221190]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Close] &gt; [MA_50] AND [Close] &gt; [MA_200] THEN &quot;Strong uptrend&quot;&#13;&#10;  ELSEIF [Close] &gt; [MA_50] AND [Close] &lt; [MA_200] THEN &quot;Short-term bullish&quot;&#13;&#10;  ELSEIF [Close] &lt; [MA_50] AND [Close] &gt; [MA_200] THEN &quot;Short-term bearish&quot;&#13;&#10;  ELSE &quot;Strong downtrend&quot;&#13;&#10;  END' />
      </column>
      <column caption='Risk Tier' datatype='string' name='[Calculation_0691347520294919]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Volatility_20] &gt; 0.025 THEN &quot;High risk&quot;&#13;&#10;  ELSEIF [Volatility_20] &gt; 0.015 THEN &quot;Medium risk&quot;&#13;&#10;  ELSE &quot;Low risk&quot;&#13;&#10;  END' />
      </column>
      <column caption='Avg Daily Return %' datatype='real' name='[Calculation_0691347520389128]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Daily_Return]) * 100' />
      </column>
      <column caption='Forecast Range' datatype='real' name='[Calculation_0691347520495625]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[upper_bound] - [lower_bound]' />
      </column>
